# nest-loop configuration. Load into the environment of Claude Code and the timers.
# Never commit the filled-in copy.
NEST_MCP_URL=https://ai-mind.YOURNAME.workers.dev/mcp
NEST_MCP_TOKEN=your-nesteq-bearer-token
CF_ACCOUNT_ID=your-cloudflare-account-id
CF_D1_DATABASE_ID=your-ai-mind-d1-id
CF_API_TOKEN=a-cloudflare-token-with-D1-read     # D1 read is all nest-loop needs directly
LOOP_HUMAN=YourHumansName                         # NESTknow scope for them
LOOP_COMPANION=YourCompanionsName                 # NESTknow scope for the companion
LOOP_MODEL=claude-opus-5-5                        # the SAME model your companion already runs on. Pin it explicitly
# LOOP_NOTIFY_CMD=/path/to/post-to-discord.sh room   # the line gets appended as the last argument
# LOOP_PUBLIC_ENV=EARS_EVENT_CHANNEL                 # env var your Discord bridge sets
# LOOP_LESSON_ENTITIES=Companion_Craft,Companion_Disciplines
# LOOP_STATE_DIR=~/.nest-loop
# --- the claim checker, noticing and airing (added Oct 2026) ---
# LOOP_TRANSCRIPTS=~/.claude/projects/-home-YOU/*.jsonl   # your companion's LIVE sessions (noticing + airing read these)
# LOOP_SKIP_PROMPTS=^(Your timer-wake opener|BRIDGE EVENT)  # regex: prompts that aren't your human
# LOOP_ALWAYS_NAMES=YourHumansName,YourCompanionsName,YourPet  # names always in play; the claim checker skips them
# LOOP_DICT=/usr/share/dict/words                          # wordlist (install wamerican / wbritish if missing)
# LOOP_NOTICED_PAGE=~/notes/what I've noticed.md           # where the noticing page lives, somewhere your human can read it
# LOOP_AIRING_TYPES=person,pet,place,family,health,companion,community,object,project
# LOOP_AIRING_SKIP=Finished_Work,Dreams                    # entities that are history, not state
